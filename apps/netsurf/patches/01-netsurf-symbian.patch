+int nsfb_sym_step(void)
+{
+	nsfb_event_t event;
+	int timeout;
+
+	/* handle all queued input */
+	while (fb_complete != true && nsfb_symbian_input_pending()) {
+		if (fbtk_event(fbtk, &event, 0)) {
+			if ((event.type == NSFB_EVENT_CONTROL) &&
+			    (event.value.controlcode ==  NSFB_CONTROL_QUIT))
+				fb_complete = true;
+		}
+	}
+	if (fb_complete == true)
+		return -2;
+
+	timeout = schedule_run();
+
+	if (fbtk_get_redraw_pending(fbtk))
+		timeout = 0;
+
+	fbtk_redraw(fbtk);
+
+	if (fbtk_get_redraw_pending(fbtk))
+		timeout = 0;
+
+	return timeout;
+}
