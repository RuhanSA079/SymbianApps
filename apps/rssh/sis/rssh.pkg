; rSSH installation package (built with: ./sym sh env/build.sh apps/rssh)
&EN
#{"rSSH"},(0xE5A1E010),0,1,0
%{"SymbianApps"}
:"SymbianApps"

; Symbian^3 product ID (E7, N8, C7, ...; also covers Anna/Belle)
[0x20022E6D],0,0,0,{"S60ProductID"}

"$(EPOCROOT)epoc32\release\gcce\urel\rssh.exe"                      -"!:\sys\bin\rssh.exe"
"$(EPOCROOT)epoc32\data\z\resource\apps\rssh.rsc"                   -"!:\resource\apps\rssh.rsc"
"$(EPOCROOT)epoc32\data\z\private\10003a3f\import\apps\rssh_reg.rsc" -"!:\private\10003a3f\import\apps\rssh_reg.rsc"
; app icon (SVG)
"..\build\icon\rssh_aif.mif"                                     -"!:\resource\apps\rssh_aif.mif"
