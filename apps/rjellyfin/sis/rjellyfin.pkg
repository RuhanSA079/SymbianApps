; rJellyfin installation package (built with: ./sym sh env/build.sh apps/rjellyfin)
&EN
#{"rJellyfin"},(0xE5A1E050),0,1,0
%{"SymbianApps"}
:"SymbianApps"

; Symbian^3 product ID (E7, N8, C7, ...; also covers Anna/Belle)
[0x20022E6D],0,0,0,{"S60ProductID"}

"$(EPOCROOT)epoc32\release\gcce\urel\rjellyfin.exe"                      -"!:\sys\bin\rjellyfin.exe"
"$(EPOCROOT)epoc32\data\z\resource\apps\rjellyfin.rsc"                   -"!:\resource\apps\rjellyfin.rsc"
"$(EPOCROOT)epoc32\data\z\private\10003a3f\import\apps\rjellyfin_reg.rsc" -"!:\private\10003a3f\import\apps\rjellyfin_reg.rsc"
; app icon (SVG)
"..\build\icon\rjellyfin_aif.mif"                                     -"!:\resource\apps\rjellyfin_aif.mif"
; root certificates for https:// servers (Mozilla's, NetSurf's copy)
"..\build\ca-bundle"                                                   -"!:\private\E5A1E050\ca-bundle"
